class Node:
    def __init__(self, key):
        self.right = None
        self.left = None
        self.val = key
        
def insert(root, key):
    if root is None:
        return Node(key)
    else:
        if root.val == key:
            return root
        elif (key < root.val):
            root.left = insert(root.left, key)
        else:
            root.right = insert(root.right, key)
        return root
    
def in_order(root):
    if root:
        in_order(root.left)
        print(root.val, end=" ")
        in_order(root.right)
        
#constructing the node
a = Node(15)
a = insert(a,20)
