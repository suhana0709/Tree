class Node:
    def __init__(self, data):
        self.left = None
        self.right = None
        self.data = data
        
#function to print nodes having exactly one child
def print_single_child_nodes(root):
    if root is None:
        return
    result = []
    #tree traversal function
    def traverse(node):
        if node is None:
            return
        #if only one child
        if (node.left is not None and node.right is None) or \
        (node.left is None and node.right is not None):
            result.append(node.data)
            
        traverse(node.left)
        traverse(node.right)
    
    traverse(root)
        
    #Output
    if len(result) == 0:
        print(-1)
    else: 
        print("Nodes with exactly one child:- ")
        for x in result:
            print(x, end=' ')
#Constructing the Node
a = Node(1)

a.left = Node(2)
a.right = Node(3)

a.left.right = Node(4)
a.right.left = Node(5)
a.right.left.left = Node(6)
#Driver Code
print_single_child_nodes(a)
