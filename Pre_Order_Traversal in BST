class Node:
    def __init__(self, key):
        self.right = None
        self.left = None
        self.val = key
        
def insert(root, key):
    if root is None:
        return Node(key)
    else:
        if root.val == key:
            return root
        elif root.val < key:
            root.right = insert(root.right, key)
        else:
            root.left = insert(root.left, key)
        return root
    
def pre_order(root):
    if root is None:
        return
    print(root.val, end=' ')
    pre_order(root.left)
    pre_order(root.right)
    
